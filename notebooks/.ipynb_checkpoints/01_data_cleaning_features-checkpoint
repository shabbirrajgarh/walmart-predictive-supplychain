   "source": [
    "# Convert Date to datetime format\n",
    "df['Date'] = pd.to_datetime(df['Date'], format='%d-%m-%Y')\n",
    "\n",
    "# Extract key temporal supply chain features\n",
    "df['Year'] = df['Date'].dt.year\n",
    "df['Month'] = df['Date'].dt.month\n",
    "df['WeekOfYear'] = df['Date'].dt.isocalendar().week.astype(int)\n",
    "df['DayOfWeek'] = df['Date'].dt.dayofweek\n",
    "\n",
    "# Weather impact flags (°F)\n",
    "df['Is_Extreme_Cold'] = (df['Temperature'] < 32).astype(int)\n",
    "df['Is_Extreme_Heat'] = (df['Temperature'] > 85).astype(int)\n",
    "\n",
    "# Sort chronologically by Store and Date\n",
    "df = df.sort_values(by=['Store', 'Date']).reset_index(drop=True)\n",
    "\n",
    "print(\"Feature Engineering Complete!\")\n",
    "df[['Store', 'Date', 'Weekly_Sales', 'Holiday_Flag', 'Year', 'Month', 'WeekOfYear']].head()"
   ]
